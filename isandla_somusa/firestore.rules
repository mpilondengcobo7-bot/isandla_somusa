rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return request.auth.uid == uid; }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasRole(role) { return getUserData().role == role; }
    function isAdmin() { return hasRole('admin'); }
    function isDonor() { return hasRole('donor'); }
    function isRecipient() { return hasRole('recipient'); }
    function isActive() { return getUserData().isActive == true; }

    // ── Users collection ──────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── Donations collection ──────────────────────────────────────────
    match /donations/{donationId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isDonor() && isActive()
        && request.resource.data.donorId == request.auth.uid;
      allow update: if isSignedIn() && (
        isOwner(resource.data.donorId) || isAdmin()
      );
      allow delete: if isSignedIn() && (
        isOwner(resource.data.donorId) || isAdmin()
      );
    }

    // ── Requests collection ───────────────────────────────────────────
    match /requests/{requestId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.recipientId) ||
        isOwner(resource.data.donorId) ||
        isAdmin()
      );
      allow create: if isSignedIn() && isRecipient() && isActive()
        && request.resource.data.recipientId == request.auth.uid;
      allow update: if isSignedIn() && (
        isOwner(resource.data.donorId) ||
        isOwner(resource.data.recipientId) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ── Ratings collection ────────────────────────────────────────────
    match /ratings/{ratingId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isActive()
        && request.resource.data.raterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── Notifications collection ──────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isSignedIn() && isOwner(resource.data.userId);
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isOwner(resource.data.userId);
      allow delete: if isSignedIn() && (
        isOwner(resource.data.userId) || isAdmin()
      );
    }
  }
}
